#!/bin/sh
set -eu

if [ "$#" -eq 0 ]; then
    exec find cmd internal ui -type d -name node_modules -prune -o \
        -type f -name '*.go' -exec "$0" {} +
fi

unformatted=$(gofmt -l -- "$@")
if [ -n "$unformatted" ]; then
    printf 'Run gofmt on these files:\n%s\n' "$unformatted" >&2
    exit 1
fi
